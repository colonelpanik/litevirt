vendor/

# Generated protobuf — tracked but excluded from dirty-check accidents
# gen/ is tracked; uncomment below if you want to ignore it:
# gen/

# Litevirt runtime files
/var/lib/litevirt/
state.db
state.db-wal
state.db-shm

# PKI / secrets — never commit private keys
*.key
*.pem
*.p12

# Config with potential secrets
/etc/litevirt/
config.local.yaml

# Local review scratch: repro tests, captured logs, diagnostic patches and
# libvirt dumps written while working a PR. This debris accumulates untracked
# and gets swept in by a blanket `git add`, which is how something captured
# from a real cluster would reach a public commit. Already-tracked review docs
# are unaffected — ignore rules do not untrack — and a review note genuinely
# meant to be published can still be added with `git add -f`.
docs/reviews/

# Downloaded front-end vendor assets (fetched by `make vendor-js`, embedded at build)
internal/ui/static/vendor/uplot/
internal/ui/static/vendor/htmx/
internal/ui/static/fonts/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test artifacts
testdata/tmp/

# golangci-lint cache
.golangci-lint-cache/

# Air (live reload)
.air.toml
tmp/
/litevirt

# CI guard binaries. `make ci-guards` uses `go run`, but `go build ./scripts/ci/X/`
# writes its output to the working directory — which is how 3.3MB of runningcheck
# once ended up committed. All four, not just the two that have happened.
/runningcheck
/stmtshapecheck
/writecheck
/schemacheck

# Private working notes — internal roadmap/specs/bug-plans, never published to the mirror
/TODO.md
/BUGS.md
/Plan.md
/PLAN.md
/Specification.md

# Claude Code local config / agents / skills / settings — never published
.claude/
CLAUDE.local.md

# Isolated local feature worktrees.
.worktrees/

# Local planning artifacts (superpowers specs/plans) — not part of the repo
docs/superpowers/
